# Copy to api/.env.test — it is gitignored, like .env.
#
# The integration tests TRUNCATE every table on every run. This file exists so
# they can never inherit the credentials in .env, which point at the live
# database. Point DB_NAME at a database that exists only to be destroyed.
#
#   createdb -h <host> -U <user> invoice_generator_test
#   DB_NAME=invoice_generator_test npm run migrate
#
# The name must contain "test" or the suite refuses to run — see
# isDisposableDatabase() in src/test/helpers.ts.

DB_HOST=192.168.1.3
DB_PORT=5432
DB_NAME=invoice_generator_test
DB_USER=nesticle8bit
DB_PASSWORD=replace-me
DB_SSL=false

NODE_ENV=test

# Not a real secret — the tests only need one that clears the length check.
JWT_SECRET=test-only-secret-not-used-anywhere-else-0123456789

# Keeps uploaded fixtures out of the real uploads directory.
UPLOAD_DIR=uploads-test
AUTO_MIGRATE=false
