#  App
# Port exposed on the host (nginx → Angular)
APP_PORT=80

#  Database (external PostgreSQL)
DB_HOST=192.168.1.3
DB_PORT=5432
DB_NAME=invoice_generator
DB_USER=nesticle8bit
DB_PASSWORD=your_postgres_password
# Set to true when the database requires TLS (managed providers usually do)
DB_SSL=false

#  JWT
# Required. Minimum 32 characters — the API refuses to start otherwise.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_very_long_random_secret
JWT_EXPIRES_IN=7d

#  CORS
# Comma-separated list of allowed browser origins. Leave empty in production
# when the UI is served from the same origin through nginx.
CORS_ORIGINS=

#  Migrations
# Pending migrations are applied on boot. Set to false only when an external
# tool owns the schema — the API then starts without checking it.
AUTO_MIGRATE=true

#  Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
